# backend/.env.example
# Copia este ficheiro para .env e preenche os valores marcados abaixo.
# NUNCA commits o teu .env real (credenciais, URLs internas) — só este
# .env.example, com placeholders.

# --- URLs de export CSV do ServiceNow (instância NOVA: edpon.service-now.com) ---
# Migração 2026-08: PRINCIPAL_URL, SLA3_URL, SLA4_URL e OK_URL trocaram de
# instância E de tipo de export (sys_report_template.do -> incident_list.do /
# task_sla_list.do / label_entry_list.do). Ver services/transform.py e
# services/sla_service.py para o que mudou na lógica por causa disso.

# PRINCIPAL_URL = "GCC Abertos": todos os incidentes com origem GCC — alimenta
# KPIs, prioridade, ferramentas, incidentes, operadores, qualidade.
PRINCIPAL_URL=

# SLA3_URL = "SLA 3": todos os P1 abertos na EDP. SLA3% = quantos desses
# também aparecem em PRINCIPAL_URL (origem GCC), meta 70%.
SLA3_URL=

# SLA4_URL = "SLA 4" (ainda em estudo): tasks de incidentes abertos pelo GCC,
# pra ver quais tinham task de P1 e passaram pra outra prioridade.
SLA4_URL=

# OK_URL = "TAG OK": controlo de incidentes com tag OK resolvidos por operador.
OK_URL=

# INCS_CALLS_GCC_URL = incidentes com a tag Calls_GCC.
INCS_CALLS_GCC_URL=

# CI_URL = Configuration Items associados a incidentes (task_ci), pra saber
# quem colocou CI's em incidentes abertos pelo GCC — alimenta a Atividade
# Operacional (3º indicador) e a view "CI's em INCs do AIOPS".
CI_URL=

# DESPROMOVIDOS_URL não vem daqui — é montada dinamicamente em cache.py
# (_build_despromovidos_url) a partir de team_service.get_usuarios(), pra
# incluir automaticamente qualquer operador novo sem editar URL nenhuma à mão.

# --- Fontes fora do ServiceNow (SharePoint) ---
CALLS_URL=
JUSTIFICACOES_URL=

# --- Credenciais ServiceNow (NUNCA a tua conta pessoal em produção — usa uma
# conta de serviço dedicada) ---
SN_USER=troca-me
SN_PASS=troca-me

# --- Nomes dos ficheiros para download manual (export EXCEL, .xls) ---
# Nomes iguais aos que ficam em backend/downloads/ (baixados manualmente
# com o nome da própria variável de ambiente).
SN_FILENAME_PRINCIPAL=PRINCIPAL_URL.xls
SN_FILENAME_SLA3=SLA3_URL.xls
SN_FILENAME_SLA4=SLA4_URL.xls
SN_FILENAME_OK=OK_URL.xls
SN_FILENAME_INCS_CALLS_GCC=INCS_CALLS_GCC_URL.xls
SN_FILENAME_DESPROMOVIDOS=Despromovidos_URL.xls
SN_FILENAME_CI=CI_URL.xls
# Estas duas vêm de SharePoint (CALLS_URL/JUSTIFICACOES_URL), não do
# ServiceNow, mas seguem o mesmo mapeamento nome-de-ficheiro -> tabela.
SN_FILENAME_JUSTIFICACOES=JUSTIFICACOES_URL.xlsm
SN_FILENAME_CALLS=CALLS_URL.xlsx

# --- Configuração do backend ---
CACHE_REFRESH_MINUTES=20
FRONTEND_ORIGIN=http://localhost:5173

# --- Autenticação (Gestão de Turnos / Base de Dados — só admins) ---
# Nome do cabeçalho onde o proxy autenticador (ex: IIS com Windows
# Authentication) injeta o utilizador já validado. Ajusta quando o
# servidor real existir, pra bater com o que o IIS de facto produzir.
AUTH_HEADER_NAME=X-Remote-User
# Admins iniciais (username curto do ServiceNow, ex: ex134172), separados
# por vírgula — só usados UMA VEZ, pra semear a tabela team_members se
# estiver vazia (instalação de raiz). Depois disso, gere-se dentro da
# própria app (Base de Dados > Gestão de Equipa). DEIXA PREENCHIDO com
# pelo menos um username teu antes do primeiro arranque — sem isto, uma
# instalação nova fica sem NENHUM admin.
INITIAL_ADMIN_USERS=troca-me

# SÓ PARA DESENVOLVIMENTO LOCAL (sem IIS/proxy nenhum a correr) — finge
# que o pedido já vem autenticado como este username, sem precisar do
# cabeçalho acima. NUNCA definir isto num servidor real: quem tiver este
# valor no .env consegue agir como admin sem autenticação nenhuma.
# Por omissão fica VAZIO (comentado) — só descomenta na tua máquina local.
#AUTH_DEV_BYPASS_USER=troca-me

# Desligado por omissão — só ligar com uma conta de serviço dedicada
# configurada em SN_USER/SN_PASS (nunca uma conta pessoal: tentativas
# automáticas de Basic Auth podem forçar logout SAML da sessão pessoal
# no browser).
AUTO_FETCH_ENABLED=false

# --- URLs de export EXCEL pros Reports (Ibéria/Brasil, CAB, P1 Semanal) ---
# Ao contrário das URLs acima, estas não são buscadas pelo backend — o
# frontend abre-as com window.open() na sessão de browser já autenticada
# do utilizador (ver services/reports_email_service.py e
# routers/reports_email.py, endpoint /api/reports/export-config).
REPORTS_P1_SEMANAL_URL=
REPORTS_CAB_OUTAGE_URL=
REPORTS_CAB_CHANGES_URL=
REPORTS_IB_P1_MATINAL_URL=
REPORTS_IB_INCS_DIARIO_URL=
REPORTS_IB_BACKUPS_URL=
REPORTS_IB_BATCHS_URL=
REPORTS_BR_P1_MATINAL_URL=
REPORTS_BR_INCS_DIARIO_URL=
REPORTS_BR_BACKUPS_URL=
REPORTS_BR_BATCHS_URL=

# --- URLs pra Splunk Validação (motor 100% client-side, sem fetch no backend) ---
REPORTS_SPLUNKVAL_EDPON_URL=
REPORTS_SPLUNKVAL_SPLUNK_URL=

# --- URLs de export pros dados de referência do Ponto de Situação ---
REPORTS_PS_INCSOPEN_URL=
REPORTS_PS_USERSCMDB_URL=
REPORTS_PS_EQUIPAS_URL=
REPORTS_PS_APPS_URL=
